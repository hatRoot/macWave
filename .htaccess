# ============================================
# .htaccess | macwave.com.mx
# Servidor Apache — URLs limpias + HTTPS
# ============================================

Options -Indexes
RewriteEngine On

# ---- 1. FORZAR HTTPS ----
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- 2. FORZAR www (o sin www, elige uno) ----
# Si tu dominio canonical es SIN www (recomendado si tu canonical es macwave.com.mx):
RewriteCond %{HTTP_HOST} ^www\.macwave\.com\.mx [NC]
RewriteRule ^(.*)$ https://macwave.com.mx/$1 [L,R=301]

# ---- 3. URLs LIMPIAS — ocultar extensión .html ----
# Permite que /reparaciones funcione igual que /reparaciones.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ---- 4. ELIMINAR .html de la URL (si alguien llega con la extensión) ----
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- 5. CABECERAS DE SEGURIDAD Y CACHÉ HTML ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Evitar que los navegadores guarden en caché el HTML desactualizado
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# ---- 6. CACHÉ DE ACTIVOS ESTÁTICOS ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
