# ============================================
# .htaccess | macwave.com.mx
# Servidor Apache — URLs limpias + HTTPS
# ============================================

Options -Indexes
RewriteEngine On

# ---- 1. FORZAR HTTPS ----
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- 2. FORZAR www (o sin www, elige uno) ----
# Si tu dominio canonical es SIN www (recomendado si tu canonical es macwave.com.mx):
RewriteCond %{HTTP_HOST} ^www\.macwave\.com\.mx [NC]
RewriteRule ^(.*)$ https://macwave.com.mx/$1 [L,R=301]

# ---- 3. URLs LIMPIAS — ocultar extensión .html ----
# Permite que /reparaciones funcione igual que /reparaciones.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ---- 3.1 REDIRIGIR /index o /index.html DIRECTO A LA RAÍZ CANÓNICA ----
RewriteCond %{THE_REQUEST} /index(\.html)?[\s?] [NC]
RewriteRule ^(.*)index(\.html)?$ https://macwave.com.mx/ [R=301,L]

# ---- 4. ELIMINAR .html de la URL (si alguien llega con la extensión) ----
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- 4.1 REDIRECCIONES DE CONSOLIDACIÓN SEO (Cero Canibalización) ----
# Consolidar Baterías MacBook en la URL reina
Redirect 301 /cambio-bateria-macbook-pro-air https://macwave.com.mx/bateria-macbook-cdmx
Redirect 301 /cambio-bateria-macbook-pro-air.html https://macwave.com.mx/bateria-macbook-cdmx
Redirect 301 /bateria-pantalla-iphone-express https://macwave.com.mx/bateria-macbook-cdmx
Redirect 301 /bateria-pantalla-iphone-express.html https://macwave.com.mx/bateria-macbook-cdmx

# Consolidar Mac Mojada en la URL reina
Redirect 301 /mac-mojada-urgencia https://macwave.com.mx/mac-mojada-cdmx
Redirect 301 /mac-mojada-urgencia.html https://macwave.com.mx/mac-mojada-cdmx

# Fusión y consolidación de Upgrades (iMac y macOS hacia /upgrades)
Redirect 301 /reparacion-imac-cdmx https://macwave.com.mx/upgrades
Redirect 301 /reparacion-imac-cdmx.html https://macwave.com.mx/upgrades
Redirect 301 /actualizar-mac-os-vieja https://macwave.com.mx/upgrades
Redirect 301 /actualizar-mac-os-vieja.html https://macwave.com.mx/upgrades

# Fusión y consolidación de Tarjeta Lógica (GPU/video hacia /reparacion-corto-logica-mac)
Redirect 301 /reflow-gpu-mac https://macwave.com.mx/reparacion-corto-logica-mac
Redirect 301 /reflow-gpu-mac.html https://macwave.com.mx/reparacion-corto-logica-mac

# Fusión y consolidación de Soporte Corporativo hacia /empresas
Redirect 301 /software https://macwave.com.mx/empresas
Redirect 301 /software.html https://macwave.com.mx/empresas
Redirect 301 /casos-reales https://macwave.com.mx/empresas
Redirect 301 /casos-reales.html https://macwave.com.mx/empresas
Redirect 301 /reparacion-laptops-gamer-cdmx https://macwave.com.mx/reparaciones
Redirect 301 /reparacion-laptops-gamer-cdmx.html https://macwave.com.mx/reparaciones

# Redirecciones de URLs obsoletas y errores Search Console
RedirectMatch 301 ^/empresas\.html>.* https://macwave.com.mx/empresas
Redirect 301 /aviso-de-privacidad https://macwave.com.mx/terminos
Redirect 301 /aviso-de-privacidad.html https://macwave.com.mx/terminos

# ---- 5. CABECERAS DE SEGURIDAD Y PRIVACIDAD ROBOTS ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  
  # Blindaje para portales y herramientas internas (sin disparar alertas de robots.txt)
  <FilesMatch "^(dashboard-ods|status-ods|ods|tecnicos|ticket-badge)">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

# ---- 6. CACHÉ DE ACTIVOS ESTÁTICOS ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
